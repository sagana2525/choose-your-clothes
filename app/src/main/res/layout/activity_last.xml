<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".LastActivity">

    <TextView
        android:id="@+id/text_tops"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="tops"
        android:textSize="40dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/photo_tops_result"
        app:layout_constraintStart_toStartOf="parent">
    </TextView>

    <TextView
        android:id="@+id/text_bottoms"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="bottoms"
        android:textSize="40dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@+id/photo_tops_result"
        app:layout_constraintStart_toStartOf="parent">
    </TextView>

    <TextView
        android:id="@+id/text_outer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="outer"
        android:textSize="40dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@+id/photo_bottoms_result"
        app:layout_constraintStart_toStartOf="parent">
    </TextView>

    <ImageView
        android:id="@+id/photo_tops_result"
        android:layout_width="300dp"
        android:layout_height="300dp"
        app:srcCompat="@drawable/outline_crop_square"
        app:layout_constraintTop_toBottomOf="@+id/text_tops"
        app:layout_constraintStart_toStartOf="parent"/>

    <ImageView
        android:id="@+id/photo_bottoms_result"
        android:layout_width="300dp"
        android:layout_height="300dp"
        app:srcCompat="@drawable/outline_crop_square"
        app:layout_constraintTop_toBottomOf="@+id/text_bottoms"
        app:layout_constraintStart_toStartOf="parent"/>

    <ImageView
        android:id="@+id/photo_outer_result"
        android:layout_width="300dp"
        android:layout_height="300dp"
        app:srcCompat="@drawable/outline_crop_square"
        app:layout_constraintTop_toBottomOf="@+id/text_outer"
        app:layout_constraintStart_toStartOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>